# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp

# 系统文件
.DS_Store
Thumbs.db

# 学习资料文档（不是你的代码）
*.docx
*.pdf

# 环境变量（含密钥，绝不能提交，即使也是张占位）
.env
.env.*

# SQLite 数据库文件（运行时生成，可再通过脚本重建）
*.db
*.sqlite3

# ChromaDB 向量库数据（运行时生成，脚本可重建，不入库）
**/chroma_data*/

# workbuddy 工具内存数据（非学习内容，不入库）
.workbuddy/

# docx 读取临时产物（提取文本用，非学习内容）
tmp_docx_read/